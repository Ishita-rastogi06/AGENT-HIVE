# ══════════════════════════════════════════════════════════════════════════════
# AgentHive — environment configuration template
# Copy this file to .env and fill in your values before starting the app.
# ══════════════════════════════════════════════════════════════════════════════

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of the local Ollama service. Default works for a standard local install.
OLLAMA_HOST=http://localhost:11434

# Chat model to use for all agent calls. Run `ollama pull <model>` first.
OLLAMA_MODEL=llama3.2:3b

# Embedding model used by ChromaDB long-term memory.
# Run `ollama pull nomic-embed-text` to download.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── LLM behaviour ─────────────────────────────────────────────────────────────
# Maximum seconds to wait for a single LLM response before timing out.
LLM_TIMEOUT_SECONDS=60

# Maximum number of new tokens the LLM may generate per response.
LLM_MAX_TOKENS=1200

# Context window size (in tokens) passed to Ollama.
LLM_CONTEXT_WINDOW=4096

# Sampling temperature (0.0 = deterministic, 1.0 = creative).
LLM_TEMPERATURE=0.2

# When true, agents return a readable fallback message if Ollama is offline
# so the Streamlit UI remains testable without a running model.
ENABLE_OFFLINE_FALLBACK=true

# ── Workflow control ──────────────────────────────────────────────────────────
# How many times the reviewer may send a subtask back to the specialist
# before escalating to human review.
MAX_RETRIES=2

# Reviewer confidence score below which a response is retried (0.0–1.0).
LOW_CONFIDENCE_THRESHOLD=0.60

# ── Tool safety ───────────────────────────────────────────────────────────────
# Seconds before the Python sandbox child process is killed.
SANDBOX_TIMEOUT_SECONDS=10

# Seconds before an outbound API call (e.g. web search) times out.
API_TIMEOUT_SECONDS=15

# Maximum characters captured from any single tool output before truncation.
MAXIMUM_TOOL_OUTPUT_CHARS=8000

# Comma-separated list of API hostnames that tools are allowed to contact.
# Subdomains of a listed domain are automatically permitted.
ALLOWED_API_DOMAINS=api.github.com,jsonplaceholder.typicode.com,api.duckduckgo.com

# ── Short-term memory — Redis (Phase 2) ───────────────────────────────────────
# Redis connection URL for task-scoped working memory.
# REDIS_URL=redis://localhost:6379/0

# ── Database — PostgreSQL ──────────────────────────────────────────────────────
# PostgreSQL connection URL for db_query tool.
# Inside Docker Compose container network (internal container port 5432):
# DB_URL=postgresql://agenthive:agenthive@postgres:5432/agenthive
# From HOST machine connecting to Docker Compose Postgres (mapped to host port 5433):
DB_URL=postgresql://agenthive:agenthive@localhost:5433/agenthive
# For Native Local PostgreSQL setup (running directly on host):
# DB_URL=postgresql://postgres:postgres@localhost:5432/agenthive

# ── Runtime paths (override only if you move the project) ────────────────────
# These default to subdirectories of the project root and rarely need changing.
# DATA_DIR=./data
# TEMP_DIR=./temp
# WORKSPACE_DIR=./workspace
